# Agent Runtime Environment Configuration
# Copy this file to .env or .env.local for local overrides. Never commit real credentials.

# Backend Service Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security / CORS Configuration (narrow local boundary)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Model Provider (Google Colab -> vLLM -> OpenAI-compatible API)
# Leave empty or unset for offline/mock development mode
AGENT_MODEL_BASE_URL=
AGENT_MODEL_API_KEY=
AGENT_MODEL_NAME=Qwen/Qwen2.5-Coder-14B-Instruct-AWQ
AGENT_MODEL_TIMEOUT_SECONDS=60.0
AGENT_MODEL_MAX_RETRIES=2

# Workspace & Execution Limits (Phase 4 & 5)
WORKSPACE_ROOT=
MAX_FILE_SIZE_BYTES=10485760
MAX_READ_BYTES=262144
MAX_DIRECTORY_ENTRIES=1000
MAX_SEARCH_RESULTS=200
MAX_WRITE_BYTES=5242880
MAX_EDIT_BYTES=1048576
AGENT_TASK_TIMEOUT_SECONDS=300.0
AGENT_TOOL_TIMEOUT_SECONDS=30.0

# Context Management Bounds (Phase 6)
CONTEXT_WINDOW_TOKENS=32768
CONTEXT_RESERVE_OUTPUT_TOKENS=2048
CONTEXT_SAFETY_MARGIN_TOKENS=512
CONTEXT_MAX_TOOL_OUTPUT_TOKENS=1000
